# Application
APP_NAME=Inventario Papa API
APP_VERSION=0.1.0
DEBUG=false

# Database
DATABASE_URL=postgresql+psycopg2://postgres:postgres@db:5432/inventario
DATABASE_POOL_SIZE=10
DATABASE_MAX_OVERFLOW=20

# JWT
JWT_SECRET_KEY=change-me-in-production-use-secure-random-string
JWT_ALGORITHM=HS256
JWT_EXPIRE_MINUTES=480

# Password hashing
BCRYPT_ROUNDS=12

# Business rules
ALLOW_NEGATIVE_STOCK=false
CLASSIFICATION_TOLERANCE_KG=0.5
COST_ALLOCATION_METHOD=peso

# CORS
CORS_ORIGINS=http://localhost:5173,http://localhost:80

# Logging
LOG_LEVEL=INFO
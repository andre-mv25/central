{$SITE_ADDRESS::80} {
	encode gzip

	handle /api/* {
		reverse_proxy backend:3000
	}

	handle /realtime* {
		reverse_proxy backend:3000
	}

	handle /socket.io* {
		reverse_proxy backend:3000
	}

	handle {
		reverse_proxy frontend:80
	}

	log {
		output stdout
		format console
	}
}

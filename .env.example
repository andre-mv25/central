# ============================================================
# Registro de Ventas - Variables de entorno (Docker Compose)
# ------------------------------------------------------------
# 1) Copiar este archivo a  .env  en la raiz del proyecto.
# 2) POSTGRES_PASSWORD queda fija en 5052003 (clave de acceso a
#    la base de datos). JWT_SECRET se genera automaticamente con:
#       Windows :  scripts\generar-env.ps1
#       Linux/Mac: sh scripts/generar-env.sh
# 3) Nunca subir el .env resultante a un repositorio.
# ============================================================

# --- PostgreSQL (contenedor db) ---
POSTGRES_USER=ventas
POSTGRES_PASSWORD=5052003
POSTGRES_DB=registro_ventas

# --- Backend ---
# JWT_SECRET: cadena larga y aleatoria (min. 32 caracteres). Si se deja el
# valor de ejemplo, cualquiera podria firmar tokens validos.
JWT_SECRET=cambiar_por_un_secreto_largo_y_aleatorio
JWT_EXPIRES_IN=8h
# Variacion (%) que dispara la alerta de precio.
PRICE_ALERT_THRESHOLD=20

# --- Acceso (Caddy) ---
# Uso normal en la laptop del cliente: dejar :80 (HTTP local, sin dominio).
# Solo si mas adelante se publica en internet con dominio propio:
#   SITE_ADDRESS=ventas.tudominio.com
#   ACME_EMAIL=correo@tudominio.com
SITE_ADDRESS=:80
ACME_EMAIL=admin@example.com
# Puerto de la laptop donde se abre la aplicacion.
# Cambiar a 8080 (u otro) si el puerto 80 esta ocupado.
HTTP_PORT=80
HTTPS_PORT=443
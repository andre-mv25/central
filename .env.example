# ============================================================
# Registro de Ventas - Variables para Docker Compose
# Copiar a .env en la raíz del proyecto y ajustar
# ============================================================

# --- PostgreSQL (contenedor db) ---
POSTGRES_USER=ventas
POSTGRES_PASSWORD=cambiar_esta_password
POSTGRES_DB=registro_ventas

# --- Backend ---
JWT_SECRET=cambiar_por_un_secreto_largo_y_aleatorio
JWT_EXPIRES_IN=8h
PRICE_ALERT_THRESHOLD=20

# --- Caddy (proxy inverso y TLS) ---
# Modo local (sin dominio): SITE_ADDRESS=:80
# Modo produccion (TLS automatico Let's Encrypt):
#   SITE_ADDRESS=ventas.tudominio.com
#   ACME_EMAIL=tu-correo-real@tudominio.com
# Requisitos para TLS: registro DNS A del dominio apuntando a la IP del
# servidor y puertos 80 y 443 abiertos.
SITE_ADDRESS=:80
ACME_EMAIL=tu-correo-real@tudominio.com
